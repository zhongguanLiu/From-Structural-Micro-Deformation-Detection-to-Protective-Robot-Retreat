<launch>
  <!-- This launch only publishes /cmd_vel. It never starts Gazebo. -->
  <arg name="linear_speed" default="1.0"/>
  <arg name="angular_speed" default="0.50"/>
  <arg name="publish_rate" default="20.0"/>
  <node pkg="livox_laser_simulation" type="keyboard_cmd.py"
        name="a2_keyboard_teleop" output="screen" respawn="false">
    <param name="linear_speed" value="$(arg linear_speed)"/>
    <param name="angular_speed" value="$(arg angular_speed)"/>
    <param name="publish_rate" value="$(arg publish_rate)"/>
  </node>
</launch>
