<robot name="a2_mid360" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="enable_lidar" default="true"/>
  <xacro:arg name="enable_rear_lidar" default="true"/>
  <xacro:arg name="lidar_point_time_mode" default="legacy_rolling"/>
  <xacro:arg name="enable_imu" default="true"/>
  <xacro:arg name="enable_planar_move" default="true"/>
  <xacro:arg name="visualize_lidar_rays" default="false"/>
  <!-- Generic and formal callers schedule at 10 Hz.  The formal ICRA launch
       records this as scheduler configuration, distinct from the measured
       approximately 5 Hz delivery cadence on the calibrated host. -->
  <xacro:arg name="lidar_update_rate_hz" default="10.0"/>
  <!-- Generic callers may override the physical ray interval.  The formal
       ICRA2027 launch uses 0.5 to 20 m; keeping these as xacro arguments avoids
       modifying the saved world or fabricating a post-publication crop. -->
  <xacro:arg name="lidar_min_range_m" default="0.1"/>
  <xacro:arg name="lidar_max_range_m" default="100.0"/>
  <!-- Defaults remain lossless for non-ICRA callers.  The ICRA launch
       explicitly applies a stride of two only to the auxiliary tail scan. -->
  <xacro:arg name="primary_lidar_downsample" default="1"/>
  <xacro:arg name="secondary_lidar_downsample" default="1"/>

  <!-- Fixed simulation standing pose: thigh +0.75 rad and calf -1.50 rad.
       Its 0.55 m two-link legs put the foot centres 0.402428878 m below
       base_link; the 0.032 m foot radius keeps the soles on ground. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <origin xyz="0 0 0.434428878" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- [CAUTION] uncomment when convert to mujoco -->
  <!-- <mujoco>
    <compiler meshdir="../meshes" discardvisual="false" />
  </mujoco>
  <link name="world"></link>
  <joint name="floating_base_joint" type="floating">
    <parent link="world" />
    <child link="base_link" />
  </joint> -->

