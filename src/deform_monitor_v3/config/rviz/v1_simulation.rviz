Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /FAST-LIO1
        - /V1 pure micro-deformation detection1
      Splitter Ratio: 0.550000011920929
    Tree Height: 401
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Registered cloud
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Displays:
        - Alpha: 0.44999998807907104
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 210; 210; 210
          Color Transformer: FlatColor
          Decay Time: 1
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Registered cloud
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.02500000037252903
          Style: Points
          Topic: /cloud_registered
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Angle Tolerance: 0.009999999776482582
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.4000000059604645
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.25
              Color: 204; 51; 204
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 1
          Name: LIO odometry
          Position Tolerance: 0.0010000000474974513
          Queue Size: 10
          Shape:
            Alpha: 1
            Axes Length: 0.15000000596046448
            Axes Radius: 0.03999999910593033
            Color: 255; 85; 0
            Head Length: 0
            Head Radius: 0
            Shaft Length: 0.05000000074505806
            Shaft Radius: 0.03999999910593033
            Value: Axes
          Topic: /Odometry
          Unreliable: false
          Value: true
      Enabled: true
      Name: FAST-LIO
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /deform/v1/rviz/deformation_markers
          Name: Reference and scaled displacement
          Namespaces:
            detection_probability: true
            reference_support: true
            scaled_displacement: true
          Queue Size: 1
          Value: true
        - Class: rviz/MarkerArray
          Enabled: false
          Marker Topic: /deform/v1/rviz/status_markers
          Name: Monitor phase and health
          Namespaces:
            {}
          Queue Size: 10
          Value: false
      Enabled: true
      Name: V1 pure micro-deformation detection
  Enabled: true
  Global Options:
    Background Color: 8; 8; 12
    Default Light: true
    Fixed Frame: camera_init
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 25.540531158447266
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398006439209
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.684999942779541
      Target Frame: camera_init
      Yaw: 2.5099937915802
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 980
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Views:
    collapsed: false
  Width: 1500
  X: 2990
  Y: 402
