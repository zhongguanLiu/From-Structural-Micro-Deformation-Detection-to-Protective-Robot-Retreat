    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /FAST-LIO registered cloud1
        - /TF1
        - /TF1/Tree1
      Splitter Ratio: 0.5
    Tree Height: 1020
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
