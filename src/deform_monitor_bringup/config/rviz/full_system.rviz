Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /FAST-LIO1
        - /V1 micro-deformation1
      Splitter Ratio: 0.55
    Tree Height: 760
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Registered cloud
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Displays:
        - Alpha: 0.45
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 210; 210; 210
          Color Transformer: FlatColor
          Decay Time: 1
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Registered cloud
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.025
          Style: Points
          Topic: /cloud_registered
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Angle Tolerance: 0.01
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.4
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.25
              Color: 204; 51; 204
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 1
          Name: LIO odometry
          Position Tolerance: 0.001
          Queue Size: 10
          Shape:
            Alpha: 1
            Axes Length: 0.15
            Axes Radius: 0.04
            Color: 255; 85; 0
            Head Length: 0
            Head Radius: 0
            Shaft Length: 0.05
            Shaft Radius: 0.04
            Value: Axes
          Topic: /Odometry
          Unreliable: false
          Value: true
      Enabled: true
      Name: FAST-LIO
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /deform/v1/rviz/deformation_markers
          Name: Reference and scaled displacement
          Namespaces: {}
          Queue Size: 1
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /deform/v1/rviz/status_markers
          Name: Monitor phase and health
          Namespaces: {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: V1 pure micro-deformation detection
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /deform/evolution/markers
          Name: Magnitude and current-support evolution
          Namespaces: {}
          Queue Size: 1
          Value: true
        - Alpha: 0.72
          Class: rviz/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: Deformation hard-avoidance overlay
          Topic: /deform/avoidance/current_overlay
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Alpha: 0.28
          Class: rviz/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: Kinematic forecast overlay +0.5 s
          Topic: /deform/avoidance/forecast_0p5s
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Alpha: 0.22
          Class: rviz/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: false
          Name: Kinematic forecast overlay +1.0 s
          Topic: /deform/avoidance/forecast_1p0s
          Unreliable: false
          Use Timestamp: false
          Value: false
        - Alpha: 0.18
          Class: rviz/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: false
          Name: Kinematic forecast overlay +2.0 s
          Topic: /deform/avoidance/forecast_2p0s
          Unreliable: false
          Use Timestamp: false
          Value: false
      Enabled: true
      Name: Downstream evolution and avoidance map
    - Class: rviz/Group
      Displays:
        - Alpha: 0.45
          Class: rviz/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: true
          Name: Evaluation LiDAR local map
          Topic: /deform/evaluation/slam_local_map
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Alpha: 0.55
          Class: rviz/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: Evaluation fused cost map
          Topic: /deform/evaluation/fused_cost_map
          Unreliable: false
          Use Timestamp: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 43; 140; 190
          Enabled: true
          Head Diameter: 0.12
          Head Length: 0.08
          Length: 0.15
          Line Style: Lines
          Line Width: 0.04
          Name: SLAM-only baseline path
          Offset:
            X: 0
            Y: 0
            Z: 0.04
          Pose Color: 43; 140; 190
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.04
          Shaft Length: 0.08
          Topic: /deform/evaluation/baseline_path
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 49; 163; 84
          Enabled: true
          Head Diameter: 0.12
          Head Length: 0.08
          Length: 0.15
          Line Style: Lines
          Line Width: 0.06
          Name: Deformation-aware path
          Offset:
            X: 0
            Y: 0
            Z: 0.07
          Pose Color: 49; 163; 84
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.04
          Shaft Length: 0.08
          Topic: /deform/evaluation/avoidance_path
          Unreliable: false
          Value: true
      Enabled: false
      Name: Static planning comparison (enable after export)
  Enabled: true
  Global Options:
    Background Color: 8; 8; 12
    Default Light: true
    Fixed Frame: camera_init
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 15
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: camera_init
      Yaw: 2.8
    Saved: ~
Window Geometry:
  Height: 980
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 100
  Y: 80
